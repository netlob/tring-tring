# Copy to backend/.env and fill in. Don't commit .env (it's gitignored).
#
# This file is loaded BOTH by `cargo run` (via dotenvy) and by
# `docker compose up` (via env_file). Paths below are written for
# the container layout (/data, /run/secrets/apns.p8). For native
# `cargo run`, override APNS_KEY_PATH and DATABASE_URL inline.

# --- APNs ---
# In Docker (default): place your .p8 at backend/apns.p8 — compose
# mounts it at /run/secrets/apns.p8.
APNS_KEY_PATH=/run/secrets/apns.p8
# For native cargo run, comment APNS_KEY_PATH above and use:
# APNS_KEY_PATH=./apns.p8
#
# Alternative: paste the .p8 contents into APNS_KEY_PEM (handy on
# Coolify / hosts where mounting a secret file is awkward).
# APNS_KEY_PEM="-----BEGIN PRIVATE KEY-----\nMIG...\n-----END PRIVATE KEY-----"

APNS_KEY_ID=RN88QP9KJ4
APNS_TEAM_ID=FCB4S3W235
APNS_BUNDLE_ID=dev.sjoerd.tringtring
# sandbox = Debug iOS builds. production = Release / TestFlight.
APNS_ENV=sandbox

# --- Server ---
# In Docker: SQLite lives in the persistent volume at /data.
DATABASE_URL=sqlite:///data/db.sqlite?mode=rwc
# For native cargo run, switch to a relative path:
# DATABASE_URL=sqlite://./data/db.sqlite?mode=rwc

LISTEN_ADDR=0.0.0.0:8080
PUBLIC_BASE_URL=http://localhost:8080

# --- Limits ---
RATE_LIMIT_PER_MINUTE=10
MONTHLY_QUOTA=100000

# --- Litestream (all optional; leave LITESTREAM_REPLICA_URL blank to disable) ---
LITESTREAM_REPLICA_URL=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
LITESTREAM_REPLICA_ENDPOINT=

# --- Logging ---
RUST_LOG=tring_tring=debug,tower_http=debug,info
